# Copy to .env and replace placeholders locally. Never commit the real .env.
# Percent-encode special characters in passwords used in a URL.
DATABASE_URL=postgresql+psycopg://pseudo_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/pseudo

# Optional: database for integration tests (tests create an isolated schema).
# TEST_DATABASE_URL=postgresql+psycopg://pseudo_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/pseudo_test

# Local HTTP only. Set true when deploying behind HTTPS.
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# GitHub OAuth App. Never expose these values to frontend code.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8000/github/callback
FRONTEND_URL=http://127.0.0.1:5173
# Fernet key; generate once locally, preserve it across restarts.
GITHUB_TOKEN_KEY=
